class Enemy:
    def __init__(self, name, hp, attack, defense, exp, gold):
        self.name = name
        self.hp = hp
        self.attack = attack
        self.defense = defense
        self.exp = exp
        self.gold = gold



enemies = [
    Enemy("Goblin", 40, 8, 2, 20, 10),
    Enemy("Skeleton", 55, 10, 3, 30, 15),
    Enemy("Orc", 80, 14, 5, 45, 25),
    Enemy("Dark Knight", 120, 18, 8, 80, 50)
]


def battle(player, enemy):

    print("\n===================================")
    print(f"A wild {enemy.name} appeared!")
    print("===================================\n")

    while enemy.hp > 0 and player.hp > 0:

        print(f"\n{player.name}: {player.hp}/{player.max_hp} HP")
        print(f"{enemy.name}: {enemy.hp} HP")

        print("\n1. Attack")
        print("2. Use Potion")
        print("3. Run")

        choice = input("> ")

        if choice == "1":

            damage = player.attack - enemy.defense

            if damage < 1:
                damage = 1

            enemy.hp -= damage

            print(f"\nYou dealt {damage} damage!")

        elif choice == "2":
            player.use_potion()

        elif choice == "3":

            chance = random.randint(1, 100)

            if chance <= 50:
                print("\nYou escaped!")
                return
            else:
                print("\nEscape failed!")

        else:
            print("\nInvalid choice!")
            continue

        if enemy.hp <= 0:
            print(f"\nYou defeated {enemy.name}!")

            player.gain_exp(enemy.exp)

            player.gold += enemy.gold

            print(f"You got {enemy.gold} gold!")

            return

        enemy_damage = enemy.attack - player.defense

        if enemy_damage < 1:
            enemy_damage = 1

        player.hp -= enemy_damage

        print(f"{enemy.name} dealt {enemy_damage} damage!")

        if player.hp <= 0:
            print("\nYou died...")
            game_over()



def shop(player):

    while True:

        print("\n========= SHOP =========")
        print(f"GOLD: {player.gold}")
        print("1. Potion - 10 Gold")
        print("2. Mega Potion - 25 Gold")
        print("3. Exit")
        print("========================")

        choice = input("> ")

        if choice == "1":

            if player.gold >= 10:

                player.gold -= 10

                player.inventory["Potion"] = (
                    player.inventory.get("Potion", 0) + 1
                )

                print("\nBought Potion!")

            else:
                print("\nNot enough gold!")

        elif choice == "2":

            if player.gold >= 25:

                player.gold -= 25

                player.inventory["Mega Potion"] = (
                    player.inventory.get("Mega Potion", 0) + 1
                )

                print("\nBought Mega Potion!")

            else:
                print("\nNot enough gold!")

        elif choice == "3":
            break



def inventory(player):

    print("\n========= INVENTORY =========")

    for item, amount in player.inventory.items():
        print(f"{item}: {amount}")

    print("=============================\n")


def save_game(player):

    data = {
        "name": player.name,
        "level": player.level,
        "exp": player.exp,
        "gold": player.gold,
        "max_hp": player.max_hp,
        "hp": player.hp,
        "attack": player.attack,
        "defense": player.defense,
        "inventory": player.inventory
    }

    with open(SAVE_FILE, "w") as file:
        json.dump(data, file)

    print("\nGame saved!")

def load_game():

    if not os.path.exists(SAVE_FILE):
        return None

    with open(SAVE_FILE, "r") as file:
        data = json.load(file)

    player = Player(data["name"])

    player.level = data["level"]
    player.exp = data["exp"]
    player.gold = data["gold"]
    player.max_hp = data["max_hp"]
    player.hp = data["hp"]
    player.attack = data["attack"]
    player.defense = data["defense"]
    player.inventory = data["inventory"]

    return player


def explore(player):

    print("\nYou explore the area...")

    event = random.randint(1, 100)

    if event <= 70:

        enemy = random.choice(enemies)

        enemy_copy = Enemy(
            enemy.name,
            enemy.hp,
            enemy.attack,
            enemy.defense,
            enemy.exp,
            enemy.gold
        )

        battle(player, enemy_copy)

    elif event <= 90:

        gold = random.randint(5, 25)

        player.gold += gold

        print(f"\nYou found {gold} gold!")

    else:

        print("\nYou found a hidden potion!")

        player.inventory["Potion"] = (
            player.inventory.get("Potion", 0) + 1
        )



def game_over():

    print("\n===================")
    print("GAME OVER")
    print("===================\n")

    exit()



