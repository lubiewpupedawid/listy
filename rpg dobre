def start():

    print("\n==========================")
    print(" PYTHON RPG ")
    print("==========================")

    print("\n1. New Game")
    print("2. Load Game")

    choice = input("> ")

    if choice == "1":

        name = input("\nEnter your name: ")

        player = Player(name)

        main_menu(player)

    elif choice == "2":

        player = load_game()

        if player:
            print("\nSave loaded!")
            main_menu(player)
        else:
            print("\nNo save file found!")

    else:
        print("\nInvalid choice!")



