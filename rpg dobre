class Player:
    def __init__(self, name):
        self.name = name
        self.level = 1
        self.exp = 0
        self.gold = 50

        self.max_hp = 100
        self.hp = self.max_hp

        self.attack = 10
        self.defense = 5

        self.inventory = {
            "Potion": 3
        }

    def show_stats(self):
        print("\n====================")
        print(f"NAME: {self.name}")
        print(f"LEVEL: {self.level}")
        print(f"EXP: {self.exp}")
        print(f"GOLD: {self.gold}")
        print(f"HP: {self.hp}/{self.max_hp}")
        print(f"ATK: {self.attack}")
        print(f"DEF: {self.defense}")
        print("====================\n")

    def gain_exp(self, amount):
        self.exp += amount
        print(f"\nYou gained {amount} EXP!")

        while self.exp >= self.level * 50:
            self.level_up()

    def level_up(self):
        self.exp -= self.level * 50
        self.level += 1

        self.max_hp += 20
        self.attack += 4
        self.defense += 2

        self.hp = self.max_hp

        print("\n====================")
        print("LEVEL UP!")
        print(f"You are now level {self.level}")
        print("====================\n")

    def use_potion(self):
        if self.inventory.get("Potion", 0) > 0:
            heal = items["Potion"]["heal"]

            self.hp += heal

            if self.hp > self.max_hp:
                self.hp = self.max_hp

            self.inventory["Potion"] -= 1

            print(f"\nYou used Potion and healed {heal} HP!")

        else:
            print("\nNo potions left!")

