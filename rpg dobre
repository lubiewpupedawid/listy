def cast_spell(player, enemy):

    print("\nChoose spell:")

    spell_list = list(spells.keys())

    for i, spell in enumerate(spell_list):
        data = spells[spell]

        print(
            f"{i+1}. {spell} "
            f"(DMG {data['damage']}, "
            f"Mana {data['mana']})"
        )

    choice = input("> ")

    try:

        spell_name = spell_list[int(choice)-1]

        spell = spells[spell_name]

        if player.mana >= spell["mana"]:

            player.mana -= spell["mana"]

            enemy.hp -= spell["damage"]

            print(
                f"\nYou cast {spell_name}!"
            )

            print(
                f"{enemy.name} took "
                f"{spell['damage']} damage!"
            )

        else:
            print("\nNot enough mana!")

    except:
        print("\nInvalid spell!")



